<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- No PackageReference to EasyDI or EasyDI.LifecycleHooks here. This is the sample project
       for the addon, so it consumes the sources in this repo through EasyDI.Godot.Core below,
       which references both transitively. Restoring them from nuget.org as well would test a
       published release rather than the working tree, and ship two copies of EasyDI.dll. -->
  <ItemGroup>
    <Content Include="addons\EasyDI.Godot\plugin.cfg" />
    <Content Include="addons\EasyDI.Godot\README.md" />
    <Content Include="addons\EasyDI.Godot\ReadMeImages\CreateApplicationLifetimeImage.png" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include=".godot\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\EasyDI.Godot.Core\EasyDI.Godot.Core.csproj" />
  </ItemGroup>
</Project>