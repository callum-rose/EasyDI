<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>EasyDI.Godot</RootNamespace>
        <LangVersion>12</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Package identity. Shared metadata — licence, repository, symbols — lives in
             Directory.Build.props. -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>CallumRose.EasyDI.Godot.Core</PackageId>
        <Version>1.0.6</Version>
        <Title>EasyDI.Godot.Core</Title>
        <Description>Contains the core classes to get EasyDI LifetimeScopes working in Godot</Description>
        <PackageTags>dependency-injection;container;ioc;di;godot</PackageTags>

        <!-- Overrides the solution-wide default, which is Callum Rose. -->
        <Authors>Alex Williams</Authors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="GodotSharp" Version="4.5.1" />
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.2"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\EasyDI.LifecycleHooks\EasyDI.LifecycleHooks.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="ScriptTemplates\**" Pack="true" PackagePath="ScriptTemplates\"/>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
