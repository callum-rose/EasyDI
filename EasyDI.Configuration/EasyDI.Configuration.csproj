<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>EasyDI.Configuration</RootNamespace>
        <LangVersion>12</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>

        <!-- Package identity. Shared metadata — authors, licence, repository, symbols —
             lives in Directory.Build.props. -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>CallumRose.EasyDI.Configuration</PackageId>
        <Version>1.1.0</Version>
        <Title>EasyDI.Configuration</Title>
        <Description>Configure Microsoft.Extensions.Options from Microsoft.Extensions.Configuration with EasyDI</Description>
        <PackageTags>dependency-injection;container;ioc;di;configuration;options</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\EasyDI.Analyzers\EasyDI.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
      <ProjectReference Include="..\EasyDI\EasyDI.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.10" />
      <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.10" />
      <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.10" />
      <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="9.0.10" />
    </ItemGroup>

</Project>
