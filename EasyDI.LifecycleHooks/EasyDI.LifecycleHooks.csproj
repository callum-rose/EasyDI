<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>EasyDI.LifecycleHooks</RootNamespace>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <!-- Package identity. Shared metadata — authors, licence, repository, symbols —
             lives in Directory.Build.props. -->
        <PackageId>CallumRose.EasyDI.LifecycleHooks</PackageId>
        <PackageVersion>1.0.4</PackageVersion>
        <Description>Frameworks for setting up application lifecycle hooks using EasyDI</Description>
        <PackageTags>dependency-injection;container;ioc;di;lifecycle;hooks</PackageTags>

        <LangVersion>13</LangVersion>
        <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\EasyDI.Analyzers\EasyDI.Analyzers.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
        <ProjectReference Include="..\EasyDI\EasyDI.csproj"/>
    </ItemGroup>

</Project>
