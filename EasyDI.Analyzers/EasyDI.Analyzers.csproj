<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>EasyDI.Analyzers</RootNamespace>
        <Nullable>enable</Nullable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <LangVersion>13</LangVersion>
        <EmbedRuntimeContracts>true</EmbedRuntimeContracts>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <!-- Package identity. Shared metadata — authors, licence, repository — lives in
             Directory.Build.props. -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <DevelopmentDependency>true</DevelopmentDependency>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <PackageId>CallumRose.EasyDI.Analyzers</PackageId>
        <Version>1.0.5</Version>
        <Description>Roslyn analyzers that catch EasyDI registration and lifecycle mistakes at compile time</Description>
        <PackageTags>dependency-injection;container;ioc;di;analyzers;roslyn</PackageTags>

        <!-- Overrides the solution-wide default. IncludeBuildOutput is off above — the DLL is
             packed by hand into analyzers/dotnet/cs — so there is no lib/ for a symbols package
             to describe, and asking for one produces an empty .snupkg. -->
        <IncludeSymbols>false</IncludeSymbols>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.5.0" PrivateAssets="all"/>
    </ItemGroup>

    <!-- Include the analyzer DLL in the NuGet package -->
    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>